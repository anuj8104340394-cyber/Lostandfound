# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus_lost_found?retryWrites=true&w=majority

# JWT Secret for signing authentication tokens
JWT_SECRET=super_secret_jwt_key_replace_with_a_secure_random_string

# Cloudinary Credentials (Storage as a Service)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Client URL (For CORS whitelist)
# In development: http://localhost:5173
# In production: https://your-campus-lost-found.onrender.com
CLIENT_URL=http://localhost:5173
